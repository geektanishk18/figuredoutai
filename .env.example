# Resend — server-side only. Never expose with a NEXT_PUBLIC_ prefix.
# Used by app/api/lead/route.ts.
RESEND_API_KEY=

# Where audit requests are delivered. Server-side only — this address must never
# appear in rendered HTML or a client bundle.
LEAD_DELIVERY_EMAIL=

# Verified Resend sender. Required — there is no default, because an unverified
# sender is rejected and the lead is lost with no error surfaced. Must be a
# dedicated sending address, not the public enquiry mailbox. Verify the domain
# at resend.com/domains. Unset = lead delivery paused (POST returns 503).
LEAD_FROM_EMAIL=

# Absolute site origin, used for metadataBase, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://figuredoutai.com
