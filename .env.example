# The contact form's only send path. Get a key by entering an email at
# web3forms.com — no account, no password — and paste it here before running
# the build.
#
# `NEXT_PUBLIC_` because this is a static export: there is no server left at
# request time to read a server-only variable from, so this is inlined into
# the client bundle at build time instead. That is expected and is how
# Web3Forms is designed to work — the key identifies where to route a
# submission, not a secret that gates who can send one. The delivery address
# itself is configured in the Web3Forms dashboard, not here.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Absolute site origin, used for metadataBase, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://figuredoutai.com
