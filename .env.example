# Resend — server-side only. Never expose with a NEXT_PUBLIC_ prefix.
# Used by app/api/lead/route.ts.
RESEND_API_KEY=

# Where audit requests are delivered. Server-side only — this address must never
# appear in rendered HTML or a client bundle.
LEAD_DELIVERY_EMAIL=

# Verified Resend sender. Required — there is no default, because an unverified
# sender is rejected and the lead is lost with no error surfaced. Must be a
# dedicated sending address, not the public enquiry mailbox. Verify the domain
# at resend.com/domains. Unset = lead delivery paused (POST returns 503).
LEAD_FROM_EMAIL=

# Absolute site origin, used for metadataBase, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://figuredoutai.com

# Static-export-only (Hostinger shared hosting). Leave unset on Netlify — the
# real server there delivers leads via RESEND_API_KEY above, and LeadForm
# prefers that path whenever this is empty.
#
# A static export has no server, so app/api/lead cannot exist in that build:
# `output: 'export'` fails outright with app/api/lead present. Get a key by
# entering an email at web3forms.com — no account, no password — and paste it
# here before running the static build. It is meant to ship in the client
# bundle: Web3Forms uses it to route a submission, not to authenticate one.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
