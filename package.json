    "clsx": "2.1.1",
    "lucide-react": "0.554.0",
    "next": "15.5.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.24",
