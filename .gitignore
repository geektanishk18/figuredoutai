# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt
.vercel
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — every shape, everywhere, not just the root. .env.example is the one
# exception and is force-added below since it holds no real values.
.env
.env.*
!.env.example

# legacy Vite site, kept for reference during the rebuild
/legacy
tsconfig.tsbuildinfo

# local tooling config — contains machine-specific absolute paths
/.claude

# design canvas archive — reference only, never imported or shipped
/design

# build and verification artefacts — regenerated on demand, never committed
*.log
snap_*.html
snapshot_*.html
about.html

# Netlify CLI local state and build output — machine-specific, never committed
.netlify/
