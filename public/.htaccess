# Hostinger (Apache) config for the static export in `out/`.
# Copied into the build output automatically — everything in public/ is.

# The clinics page shipped at /industries/medical-clinics before the canvas
# settled on /industries/clinics. The old path was live and is linked from
# outside the site, so it redirects permanently rather than 404ing. This
# replaces the `redirects()` entry in next.config.mjs, which has no effect
# once the build is a static export — there is no Next server left to run it.
# The rule itself is the first RewriteRule below.

RewriteEngine On

# Every redirect below goes straight to the final URL — https, no www, with the
# trailing slash — so any variant of a page resolves in ONE 301, not a chain.
# Before this, http://www.figuredoutai.com/about took two hops (scheme+host,
# then Apache's own directory-slash redirect), and each extra hop is crawl
# budget and link equity lost along the way.
#
# The canonical host is written out rather than taken from the request: the
# canonical tag on every page names https://figuredoutai.com, and the redirect
# should agree with it exactly.

# Old clinics path (see above). Anchored, so /industries/medical-clinics/ with
# a trailing slash cannot become /industries/clinics// the way the old
# prefix-matching `Redirect` directive would have made it.
RewriteRule ^industries/medical-clinics/?$ https://figuredoutai.com/industries/clinics/ [L,R=301]

# Plain-http requests. Hostinger terminates TLS in front of Apache on some
# plans, so both the direct flag and the forwarded header are checked.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ - [E=FO_INSECURE:1]

# trailingSlash: true builds every route to <route>/index.html. A request for
# /about goes straight to https://figuredoutai.com/about/ — whatever host or
# scheme it arrived on — instead of first fixing the host and then letting
# Apache's DirectorySlash add the slash in a second hop.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ https://figuredoutai.com/$1/ [L,R=301]

# Anything else on www or plain http: same path, canonical origin.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{ENV:FO_INSECURE} =1
RewriteRule ^(.*)$ https://figuredoutai.com/$1 [L,R=301]

# Each route's social card exports as a file named `opengraph-image` with no
# extension, so Apache serves it with no Content-Type at all. LinkedIn and
# Facebook can refuse a preview image that isn't declared as an image. They
# are all 1200x630 PNGs.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

ErrorDocument 404 /404.html
