# Hostinger (Apache) config for the static export in `out/`.
# Copied into the build output automatically — everything in public/ is.

# The clinics page shipped at /industries/medical-clinics before the canvas
# settled on /industries/clinics. The old path was live and is linked from
# outside the site, so it redirects permanently rather than 404ing. This
# replaces the `redirects()` entry in next.config.mjs, which has no effect
# once the build is a static export — there is no Next server left to run it.
Redirect 301 /industries/medical-clinics /industries/clinics/

RewriteEngine On

# One origin, one canonical form. Every page declares
# https://figuredoutai.com/... as its canonical; without these two rules the
# www and http variants can still serve a 200, which splits the same content
# across up to four addressable origins and leaves a crawler to guess which
# the canonical tag meant.
#
# Ordered host-then-scheme, and both use R=301 with L so each redirect
# resolves in a single hop rather than chaining www→non-www→https.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# trailingSlash: true means every route builds to <route>/index.html. A
# request for /about (no trailing slash) needs to resolve to the same file
# without a visible redirect loop or a 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

ErrorDocument 404 /404.html
